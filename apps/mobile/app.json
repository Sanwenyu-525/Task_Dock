{
  "expo": {
    "name": "TaskDock",
    "slug": "taskdock",
    "version": "0.1.7",
    "orientation": "portrait",
    "scheme": "taskdock",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "dev.taskdock.mobile",
      "versionCode": 22,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/adaptive-background.png"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "./plugins/withCleartextTraffic.js",
      "./plugins/withShareTargetActivity.js",
      "./plugins/withTaskDockWidgets.js",
      [
        "expo-camera",
        {
          "cameraPermission": "TaskDock 使用相机扫描桌面端配对二维码；画面只在本机处理，不上传。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "largeIcon": "./assets/icon.png",
          "color": "#4C8DFF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5FA",
          "image": "./assets/splash-mark.png",
          "imageWidth": 80,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#080D16",
            "image": "./assets/splash-mark-dark.png"
          }
        }
      ]
    ]
  }
}
