# 复制为 .env 后按实际部署修改。TURN_SECRET 必须是至少 16 字符的随机值。
HOST=0.0.0.0
PORT=3000

POSTGRES_USER=hub
POSTGRES_PASSWORD=hubpass
POSTGRES_DB=taskdock_hub

DATABASE_URL=postgres://hub:hubpass@db:5432/taskdock_hub
TURN_SECRET=replace-with-a-long-random-secret-at-least-16-chars
TURN_REALM=taskdock.local
TURN_URIS=turn:localhost:3478?transport=udp,turns:localhost:5349?transport=tcp
