{
  "version": 1,
  "description": "生活效率系统跨端契约测试向量：Rust（src-tauri/src/commands/life.rs）与 TypeScript（apps/mobile/src/domain/life.ts）读取同一份数据，任何一端单独放宽或收紧规则都会让对应用例失败。",
  "rules": {
    "money": [
      "只接受 ASCII 数字与至多一个小数点，不接受千分位、空格、科学计数法、全角数字",
      "不接受负号与显式正号",
      "必须至少有一位整数数字；有小数点时小数点后必须有数字",
      "小数位不得超过该行 amount_scale；amount_scale 不得低于货币 ISO 精度",
      "结果必须落在 ±MAX_AMOUNT_MINOR（1e12）之内"
    ],
    "quantity": [
      "与金额相同的书写约束（无符号、无千分位、必须有整数位）",
      "最多 3 位小数，整数部分最多 12 位",
      "购买数量必须大于 0；同步复制允许历史值 0"
    ]
  },
  "limits": {
    "max_amount_minor": 1000000000000,
    "max_quantity_integer_digits": 12
  },
  "name_normalization": [
    { "input": "大米", "normalized": "大米" },
    { "input": "  大米  ", "normalized": "大米" },
    { "input": "ＡＢＣ　１２３", "normalized": "abc 123" },
    { "input": "牛奶。", "normalized": "牛奶" },
    { "input": "。牛奶，", "normalized": "牛奶" },
    { "input": "大米（东北）", "normalized": "大米(东北)" },
    { "input": "Coca   Cola", "normalized": "coca cola" },
    { "input": "Milk!", "normalized": "milk" },
    { "input": "大  米", "normalized": "大 米" },
    { "input": "...", "normalized": "" },
    { "input": "   ", "normalized": "" }
  ],
  "currency_normalization": [
    { "input": "CNY", "currency": "CNY" },
    { "input": "cny", "currency": "CNY" },
    { "input": " usd ", "currency": "USD" },
    { "input": "", "currency": "" },
    { "input": "CN", "reason": "currency_format", "messagePattern": "三位字母代码" },
    { "input": "CNYY", "reason": "currency_format", "messagePattern": "三位字母代码" },
    { "input": "人民币", "reason": "currency_format", "messagePattern": "三位字母代码" }
  ],
  "currency_decimals": [
    { "input": "CNY", "decimals": 2 },
    { "input": "usd", "decimals": 2 },
    { "input": "JPY", "decimals": 0 },
    { "input": "KWD", "decimals": 3 },
    { "input": "XYZ", "reason": "currency_unsupported", "messagePattern": "暂不支持货币" }
  ],
  "amount_scale": [
    { "currency": "CNY", "requested": null, "scale": 2 },
    { "currency": "USD", "requested": null, "scale": 2 },
    { "currency": "JPY", "requested": null, "scale": 0 },
    { "currency": "KWD", "requested": null, "scale": 3 },
    { "currency": "JPY", "requested": 2, "scale": 2 },
    { "currency": "CNY", "requested": 3, "scale": 3 },
    { "currency": "KWD", "requested": 3, "scale": 3 },
    {
      "currency": "CNY",
      "requested": 1,
      "reason": "amount_scale_coarser",
      "messagePattern": "不能低于货币精度"
    },
    {
      "currency": "CNY",
      "requested": 4,
      "reason": "amount_scale_invalid",
      "messagePattern": "0–3"
    },
    {
      "currency": "XYZ",
      "requested": null,
      "reason": "currency_unsupported",
      "messagePattern": "暂不支持货币"
    }
  ],
  "money": [
    { "input": "48", "currency": "CNY", "amountScale": null, "minor": 4800 },
    { "input": "48.5", "currency": "CNY", "amountScale": null, "minor": 4850 },
    { "input": "0.05", "currency": "USD", "amountScale": null, "minor": 5 },
    { "input": "0.00", "currency": "CNY", "amountScale": null, "minor": 0 },
    { "input": "48", "currency": "JPY", "amountScale": null, "minor": 48 },
    { "input": "48.123", "currency": "KWD", "amountScale": null, "minor": 48123 },
    { "input": "100.00", "currency": "JPY", "amountScale": 2, "minor": 10000 },
    { "input": "10000000000", "currency": "CNY", "amountScale": null, "minor": 1000000000000 },
    { "input": "00048.50", "currency": "CNY", "amountScale": null, "minor": 4850 },
    {
      "input": "10000000000.01",
      "currency": "CNY",
      "amountScale": null,
      "reason": "amount_too_large",
      "messagePattern": "超出可用范围"
    },
    {
      "input": "99999999999999999999",
      "currency": "CNY",
      "amountScale": null,
      "reason": "amount_too_large",
      "messagePattern": "超出可用范围"
    },
    {
      "input": "-1",
      "currency": "CNY",
      "amountScale": null,
      "reason": "amount_negative",
      "messagePattern": "不能为负数"
    },
    {
      "input": "+1",
      "currency": "CNY",
      "amountScale": null,
      "reason": "amount_sign_not_allowed",
      "messagePattern": "不能带正号"
    },
    {
      "input": ".5",
      "currency": "CNY",
      "amountScale": null,
      "reason": "amount_integer_digits_required",
      "messagePattern": "必须包含整数部分"
    },
    {
      "input": ".",
      "currency": "CNY",
      "amountScale": null,
      "reason": "amount_integer_digits_required",
      "messagePattern": "必须包含整数部分"
    },
    {
      "input": "1.",
      "currency": "CNY",
      "amountScale": null,
      "reason": "amount_fraction_digits_required",
      "messagePattern": "小数点后必须有数字"
    },
    {
      "input": "1.2.3",
      "currency": "CNY",
      "amountScale": null,
      "reason": "amount_multiple_dots",
      "messagePattern": "小数点过多"
    },
    {
      "input": "1,000",
      "currency": "CNY",
      "amountScale": null,
      "reason": "amount_separator_not_allowed",
      "messagePattern": "只能包含数字"
    },
    {
      "input": "1 000",
      "currency": "CNY",
      "amountScale": null,
      "reason": "amount_separator_not_allowed",
      "messagePattern": "只能包含数字"
    },
    {
      "input": "１００",
      "currency": "CNY",
      "amountScale": null,
      "reason": "amount_invalid_character",
      "messagePattern": "只能包含数字"
    },
    {
      "input": "48.555",
      "currency": "CNY",
      "amountScale": null,
      "reason": "amount_precision_exceeded",
      "messagePattern": "最多支持 2 位小数"
    },
    {
      "input": "48.5",
      "currency": "JPY",
      "amountScale": null,
      "reason": "amount_precision_exceeded",
      "messagePattern": "最多支持 0 位小数"
    },
    {
      "input": "48",
      "currency": "",
      "amountScale": null,
      "reason": "amount_currency_required",
      "messagePattern": "选择货币"
    },
    {
      "input": "48.5",
      "currency": "CNY",
      "amountScale": 1,
      "reason": "amount_scale_coarser",
      "messagePattern": "不能低于货币精度"
    },
    {
      "input": "48",
      "currency": "CNY",
      "amountScale": 4,
      "reason": "amount_scale_invalid",
      "messagePattern": "0–3"
    }
  ],
  "quantity": [
    { "input": "5", "quantity": "5" },
    { "input": "5.500", "quantity": "5.5" },
    { "input": "0.250", "quantity": "0.25" },
    { "input": "0005", "quantity": "5" },
    { "input": "  7 ", "quantity": "7" },
    { "input": "999999999999.999", "quantity": "999999999999.999" },
    { "input": "100000000000.000", "quantity": "100000000000" },
    { "input": "0000000000005", "quantity": "5" },
    { "input": "", "quantity": null },
    {
      "input": "0",
      "reason": "quantity_must_be_positive",
      "messagePattern": "必须大于 0"
    },
    {
      "input": "0.000",
      "reason": "quantity_must_be_positive",
      "messagePattern": "必须大于 0"
    },
    {
      "input": "-1",
      "reason": "quantity_negative",
      "messagePattern": "不能为负数"
    },
    {
      "input": "+1",
      "reason": "quantity_sign_not_allowed",
      "messagePattern": "不能带正号"
    },
    {
      "input": ".5",
      "reason": "quantity_integer_digits_required",
      "messagePattern": "必须包含整数部分"
    },
    {
      "input": "1.",
      "reason": "quantity_fraction_digits_required",
      "messagePattern": "小数点后必须有数字"
    },
    {
      "input": "1.2.3",
      "reason": "quantity_multiple_dots",
      "messagePattern": "小数点过多"
    },
    {
      "input": "1.2345",
      "reason": "quantity_precision_exceeded",
      "messagePattern": "最多支持 3 位小数"
    },
    {
      "input": "1,5",
      "reason": "quantity_separator_not_allowed",
      "messagePattern": "只能包含数字"
    },
    {
      "input": "1 5",
      "reason": "quantity_separator_not_allowed",
      "messagePattern": "只能包含数字"
    },
    {
      "input": "1e3",
      "reason": "quantity_invalid_character",
      "messagePattern": "只能包含数字"
    },
    {
      "input": "1000000000000",
      "reason": "quantity_too_large",
      "messagePattern": "整数部分最多 12 位"
    }
  ]
}
