{
  "name": "task-dock",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Task Dock — Windows 桌面悬浮任务与 AI Agent 监控中心",
  "scripts": {
    "dev": "node scripts/build-sched.mjs run --class dev --priority P2 --label desktop-vite -- vite",
    "dev:raw": "vite",
    "build": "node scripts/build-sched.mjs run --priority P1 --label desktop-build -- npm run build:raw",
    "build:raw": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "pretauri": "node scripts/build-guard.mjs precheck",
    "tauri": "node scripts/dev-launch.mjs",
    "tauri:raw": "tauri",
    "preview": "node scripts/build-sched.mjs run --class dev --priority P2 --label desktop-preview -- vite preview",
    "preview:raw": "vite preview",
    "guard:precheck": "node scripts/build-guard.mjs precheck",
    "guard:report": "node scripts/build-guard.mjs report",
    "guard:register": "node scripts/build-guard.mjs register",
    "guard:cleanup": "node scripts/build-guard.mjs cleanup",
    "arch:guard": "node scripts/architecture/architecture-guard.mjs",
    "arch:guard:json": "node scripts/architecture/architecture-guard.mjs --json",
    "arch:deps": "node scripts/architecture/dependency-graph.mjs",
    "arch:deps:json": "node scripts/architecture/dependency-graph.mjs --json",
    "arch:boundary": "node scripts/architecture/module-boundary-check.mjs",
    "arch:dupes": "node scripts/architecture/duplicate-source-check.mjs",
    "worktree": "node scripts/worktree-guard.mjs",
    "worktree:status": "node scripts/worktree-guard.mjs status",
    "worktree:create": "node scripts/worktree-guard.mjs create",
    "worktree:check": "node scripts/worktree-guard.mjs check",
    "worktree:cleanup": "node scripts/worktree-guard.mjs cleanup",
    "test": "node scripts/build-sched.mjs run --priority P1 --label desktop-test -- npm run test:raw",
    "test:raw": "vitest run",
    "test:watch": "vitest",
    "test:scripts": "node --test --test-concurrency=1 scripts/build-guard.test.mjs scripts/worktree-guard.test.mjs scripts/dev-launch.test.mjs scripts/build-sched.test.mjs scripts/sched/provenance.test.mjs scripts/taskdock-integration.test.mjs scripts/architecture/architecture-guard.test.mjs scripts/close-metrics.test.mjs",
    "integrate": "node scripts/taskdock-integration.mjs",
    "integrate:status": "node scripts/taskdock-integration.mjs status",
    "integrate:test": "node --test scripts/taskdock-integration.test.mjs",
    "sched": "node scripts/build-sched.mjs",
    "sched:status": "node scripts/build-sched.mjs status",
    "sched:queue": "node scripts/build-sched.mjs queue",
    "sched:history": "node scripts/build-sched.mjs history",
    "sched:doctor": "node scripts/build-sched.mjs doctor",
    "sched:config": "node scripts/build-sched.mjs config",
    "sched:cancel": "node scripts/build-sched.mjs cancel",
    "sched:dev": "node scripts/build-sched.mjs dev",
    "sched:acceptance": "node --test scripts/build-sched-acceptance.test.mjs",
    "cargo": "node scripts/build-sched.mjs cargo",
    "help:check": "vitest run src/help/__tests__/registry-contract.test.ts src/help/__tests__/health.test.ts",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-autostart": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
