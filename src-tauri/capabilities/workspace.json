{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workspace",
  "description": "项目工作空间专业窗口的最小能力集：事件、文件夹选择与在本机打开路径；不继承主窗口的导航/通知/贴边吸附等插件权限。",
  "windows": ["workspace"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "opener:default"
  ]
}