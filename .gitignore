# Dependencies
node_modules/

# Build output
dist/

# 任务级工作区（验收/调试/实验；长期证据请归档到 docs/ 对应目录并更新索引）
/tmp/

# 仓库根的外置 Rust 构建目录（性能/验收用；target-* 通配覆盖未来新增隔离目录）
/target-*/

# 本地真机验收临时区（二进制副本、数据库快照）
/.acceptance/

# 视觉走查 harness（由 scripts/make-preview.mjs 生成，不入库）
.preview/

# 视觉走查临时截图（单次取证产物，长期证据请归档 docs/ 对应目录）
/.screenshots/

# Tauri / Rust（src-tauri/target-* 通配覆盖 target-accept/-dbg/-measure/-gate 及未来隔离目录；
# 归属与清理见 scripts/build-guard.mjs，docs/DEVELOPMENT.md「构建产物与磁盘空间管理」）
src-tauri/target/
src-tauri/target-*/
src-tauri/gen/

# Python bytecode cache
__pycache__/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local data (never commit user data)
*.db
*.db-shm
*.db-wal
backups/

# Local tool state / artifacts
.workbuddy/
.workbuddy-ai/
.impeccable/
.zcode/
.trae-html-share-packages/

# TS 增量构建信息（tsc --noEmit 也会落盘，纯本机缓存）
*.tsbuildinfo

# 仓库根的外来物：临时补丁文件
# 设计效果图统一归档 docs/design-refs/（不是验收证据，见 README 文档索引）
/*.patch

# Windows redirect artifact
nul

# Release installers & intermediate asset bundles
release/
taskdock_icons_tauri_ready.zip

# Local acceptance-test artifacts (real-DB safety backup, MSI logs)
.acceptance-backup/

# Stray visual-audit output from an earlier script revision
visual-audit.json
visual-audit.err

# 性能 harness 原始运行日志（DIAG-*）只在本地 tmp/ 归档，不入库；
# 结构化结果（meta/load/stimulus JSON，含 p50/p95、计数、退出码）仍归档 docs/performance/results/
docs/performance/results/DIAG-*-app.log
docs/performance/results/DIAG-*.jsonl
