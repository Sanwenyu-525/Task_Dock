# Dependencies
node_modules/

# Build output
dist/

# 任务级工作区（验收/调试/实验；长期证据请归档到 docs/ 对应目录并更新索引）
/tmp/

# 仓库根的外置 Rust 构建目录（性能/验收用）
/target-test/

# 本地真机验收临时区（二进制副本、数据库快照）
/.acceptance/

# 视觉走查 harness（由 scripts/make-preview.mjs 生成，不入库）
.preview/

# Tauri / Rust
src-tauri/target/
src-tauri/target-accept/
src-tauri/target-accept-dbg/
src-tauri/target-measure/
src-tauri/gen/

# Python bytecode cache
__pycache__/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local data (never commit user data)
*.db
*.db-shm
*.db-wal
backups/

# Local tool state / artifacts
.workbuddy/
.workbuddy-ai/

# Windows redirect artifact
nul

# Release installers & intermediate asset bundles
release/
taskdock_icons_tauri_ready.zip

# Local acceptance-test artifacts (real-DB safety backup, MSI logs)
.acceptance-backup/

# Stray visual-audit output from an earlier script revision
visual-audit.json
visual-audit.err
